{
	"name": "handshake",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.3",
	"engines": {
		"node": "26.x"
	},
	"scripts": {
		"dev": "bun --bun vite",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"typecheck": "bun --bun tsc --noEmit",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:db": "supabase test db",
		"test:api-db": "bun test --env-file=.env.local tests/api/postgres-store.test.ts",
		"api:lint": "bunx @redocly/cli@1 lint docs/api-v1.openapi.yaml",
		"gen:ledger-cases": "bun scripts/ledger-cases-sql.ts",
		"gen:permission-cases": "bun scripts/permission-cases-sql.ts",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"format": "bun --bun prettier --write .",
		"mobile:sync": "bun --bun vite build && bun --bun cap sync",
		"mobile:add:ios": "bun --bun cap add ios",
		"mobile:add:android": "bun --bun cap add android",
		"mobile:open:ios": "bun --bun cap open ios",
		"mobile:open:android": "bun --bun cap open android"
	},
	"dependencies": {
		"@capacitor/core": "^8",
		"@fontsource-variable/funnel-display": "^5.3.0",
		"@fontsource-variable/funnel-sans": "^5.3.0",
		"@fontsource-variable/shantell-sans": "^5.3.0",
		"@lucasmarkes/hairline": "^0.5.1",
		"@radix-ui/react-alert-dialog": "^1.2.1",
		"@radix-ui/react-checkbox": "^1.4.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-label": "^2.1.17",
		"@radix-ui/react-popover": "^1.3.1",
		"@radix-ui/react-radio-group": "^1.5.1",
		"@radix-ui/react-separator": "^1.2.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@radix-ui/react-tabs": "^1.2.1",
		"@radix-ui/react-toggle-group": "^1.2.1",
		"@radix-ui/react-visually-hidden": "^1.2.13",
		"@supabase/supabase-js": "^2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"country-flag-emoji-polyfill": "^0.1.10",
		"dexie": "^4",
		"dexie-react-hooks": "^4.4.0",
		"lucide-react": "^1.66.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router": "^7",
		"sonner": "^2"
	},
	"devDependencies": {
		"@capacitor/cli": "^8",
		"@types/bun": "^1.4.4",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^5",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"autoprefixer": "^10.6.2",
		"fake-indexeddb": "^6.2.8",
		"postcss": "^8.5.32",
		"prettier": "^3",
		"supabase": "^2",
		"tailwind-merge": "^2.6",
		"tailwindcss": "^3.4.17",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "^5.9",
		"vite": "^7",
		"vite-plugin-pwa": "^1"
	}
}
